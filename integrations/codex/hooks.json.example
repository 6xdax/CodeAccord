{
  "description": "Optional CodeAccord checkpoint validation and recovery.",
  "hooks": {
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/skills/codeaccord/scripts/checkpoint_hook.py\" codex",
            "statusMessage": "Checking CodeAccord checkpoint",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/skills/codeaccord/scripts/checkpoint_hook.py\" codex",
            "statusMessage": "Loading CodeAccord checkpoint",
            "additionalContextLimit": 1500,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
